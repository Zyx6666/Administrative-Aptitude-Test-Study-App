<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Idiom.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back_dark"
        app:title="内容卡片" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_progress_pill"
        android:paddingStart="18dp"
        android:paddingTop="6dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp"
        android:text="进度：1 / 20"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvIdiom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="6dp"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1">

                <FrameLayout
                    android:id="@+id/hiddenBox"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hidden">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="内容已隐藏"
                        android:textColor="#E8E8E8"
                        android:textSize="15sp" />
                </FrameLayout>

                <ScrollView
                    android:id="@+id/meaningScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvMeaning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:lineSpacingExtra="9dp"
                            android:textColor="@color/text_primary"
                            android:textSize="19sp" />
                    </LinearLayout>
                </ScrollView>
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/idleButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/btnShowMeaning"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_pill_outline_blue"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="看内容"
            android:textColor="@color/brand"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnKnowWithout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_outline_green"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="我认识，不看答案"
            android:textColor="@color/known"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_outline_gray"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="跳过"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/feedbackButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnUnknown"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_pill_outline_red"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="不会"
            android:textColor="@color/unknown"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnFuzzy"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_outline_orange"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="模糊"
            android:textColor="@color/fuzzy"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnKnown"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_outline_green"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="会了"
            android:textColor="@color/known"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
